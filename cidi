	API.SpoofGameComparator = function(Weapon, Value)
		pcall(function()
			local ComparatorPaths = {
				["Jump Pad"] = LocalPlayer.PlayerScripts.Modules.GameComponents.JumpPads,
			}

			if not ComparatorPaths[Weapon] then
				return
			end

			local Component = require(ComparatorPaths[Weapon])

			if GameComparatorHooks[Weapon] then
				GameComparatorHooks[Weapon].Skin = Value
				return
			end

			local State = { Skin = Value }
			GameComparatorHooks[Weapon] = State

			local OriginalObjectAdded = clonefunction(Component._ObjectAdded)

			hookfunction(
				Component._ObjectAdded,
				newcclosure(function(Self, P2)
					local V2 = P2:GetAttribute("ObjectID")
					local LocalFighter = Library.FighterController.LocalFighter

					if LocalFighter and LocalFighter:GetItem(V2) ~= nil then
						P2:SetAttribute("ViewModelName", State.Skin)
					end

					return OriginalObjectAdded(Self, P2)
				end)
			)
		end)
	end

	API.CreateDialog = function(JSON)
		pcall(function()
			local DialogNode = require(Services.ReplicatedStorage.Modules.DialogNode)
			local Pages = require(PlayerScripts.Modules.UserInterface.Pages)

			local ImageCache = {}
			local function GetImage(URL)
				if not URL then
					return nil
				end
				if URL:sub(1, 13) == "rbxassetid://" or URL:sub(1, 4) == "rbx:" then
					return URL
				end
				if ImageCache[URL] then
					return ImageCache[URL]
				end
				local Response = http_request or request({ Url = URL, Method = "GET" })
				local FileName = "dialog_" .. tostring(#ImageCache) .. ".png"
				writefile(FileName, Response.Body)
				local Asset = getcustomasset(FileName)
				ImageCache[URL] = Asset
				return Asset
			end

			local BuildDialog
			BuildDialog = function(Data)
				if not Data then
					return nil
				end

				local Node = DialogNode.new()

				if Data.Message then
					Node:SetMessage(GetImage(Data.Message.Image), Data.Message.Text, Data.Message.SoundID)
				end

				if Data.ButtonAppearDelay then
					Node:SetButtonAppearDelay(Data.ButtonAppearDelay)
				end

				if Data.DelayedContinue then
					Node:ContinueAfterDelay(Data.DelayedContinue.Delay, BuildDialog(Data.DelayedContinue.NextDialog))
				end

				if Data.Buttons then
					for _, Button in ipairs(Data.Buttons) do
						if Button.IsCloseButton then
							Node:AddCloseButton(Button.Text)
						else
							Node:AddButton(Button.Text, BuildDialog(Button.NextDialog), Button.ActionKey)
						end
					end
				end

				return Node
			end

			Pages.PageSystem:OpenPage("DialogLobby", true)
			local Page = Pages.PageSystem:WaitForPage("DialogLobby")

			if JSON.Actions then
				for Key, Fn in pairs(JSON.Actions) do
					Page:HookDialogActionKey(Key, Fn)
				end
			end

			Page:PlayDialog(BuildDialog(JSON.Dialog))
		end)
	end

	local function SerializeEquipped()
		local Out = {}
		for WeaponName, CosmeticTypes in pairs(Equipped) do
			Out[WeaponName] = {}
			for CosmeticType, CosmeticData in pairs(CosmeticTypes) do
				if CosmeticData and CosmeticData.Name then
					Out[WeaponName][CosmeticType] = {
						Name = CosmeticData.Name,
						Inverted = CosmeticData.Inverted or false,
						OnlyUseFavorites = CosmeticData.OnlyUseFavorites or false,
						isRandom = CosmeticData.isRandom or false,
						Seed = CosmeticData.Seed,
					}
				end
			end
			if not next(Out[WeaponName]) then
				Out[WeaponName] = nil
			end
		end
		return Out
	end

	local function DeserializeEquipped(SavedEquipped)
		for WeaponName, CosmeticTypes in pairs(SavedEquipped) do
			for CosmeticType, Saved in pairs(CosmeticTypes) do
				if not Saved then
					continue
				end

				API.SpoofGameComparator(WeaponName, Saved.Name)

				if Saved.isRandom then
					Equipped[WeaponName] = Equipped[WeaponName] or {}
					Equipped[WeaponName][CosmeticType] = {
						isRandom = true,
						Name = Saved.Name or "RANDOM_COSMETIC",
						OnlyUseFavorites = Saved.OnlyUseFavorites or false,
						Seed = Saved.Seed or math.random(1, 9999999),
						Type = CosmeticType,
					}
				else
					local Cloned = CloneCosmetic(Saved.Name, CosmeticType, {
						IsInverted = Saved.Inverted,
						OnlyUseFavorites = Saved.OnlyUseFavorites,
					})
					if Cloned then
						Equipped[WeaponName] = Equipped[WeaponName] or {}
						Equipped[WeaponName][CosmeticType] = Cloned
					end
				end
			end
		end
	end

	local function SerializeFavorites()
		local Out = {}
		for WeaponName, Cosmetics in pairs(Favorited) do
			Out[WeaponName] = {}
			for CosmeticName, IsFav in pairs(Cosmetics) do
				if IsFav then
					Out[WeaponName][CosmeticName] = true
				end
			end
			if not next(Out[WeaponName]) then
				Out[WeaponName] = nil
			end
		end
		return Out
	end

	local function DeserializeFavorites(SavedFavorites)
		Favorited = {}
		for WeaponName, Cosmetics in pairs(SavedFavorites or {}) do
			for CosmeticName, IsFav in pairs(Cosmetics or {}) do
				if IsFav then
					Favorited[WeaponName] = Favorited[WeaponName] or {}
					Favorited[WeaponName][CosmeticName] = true
				end
			end
		end
	end

