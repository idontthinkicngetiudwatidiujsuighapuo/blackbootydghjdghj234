	API.InjectToBackpack = function(Item, Quantity)
		local LootboxEffect = require(LocalPlayer.PlayerScripts.Modules.Functions.LootboxEffect)
		local CaseName = Item or "Skin Case 3"
		local RARITY_WEIGHTS = { Mythical = 3, Legendary = 10, Rare = 25, Common = 65 }

		local function OpenCase(What, Amount)
			local Char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
			local HRP = Char:WaitForChild("HumanoidRootPart")
			local Pool = POOLS[What] or POOLS["Skin Case 3"]
			if not Pool then
				return
			end

			Amount = Amount or 1

			for I = 1, Amount do
				local Available = {}
				for _, ItemData in ipairs(Pool) do
					if not UnlockedItems[ItemData.Name] then
						table.insert(Available, ItemData)
					end
				end
				if #Available == 0 then
					Available = Pool
				end

				local Weighted = {}
				for _, ItemData in ipairs(Available) do
					local W = RARITY_WEIGHTS[ItemData.Rarity] or 10
					for _ = 1, W do
						table.insert(Weighted, ItemData)
					end
				end

				local Picked = Weighted[math.random(1, #Weighted)]
				API.UnlockSpecificCosmetic(Picked.Name)

				local PickedName = Picked.Name
				local PickedWeapon = Picked.Weapon
				task.spawn(function()
					task.wait(0.1 * I)
					pcall(
						LootboxEffect,
						HRP.Position,
						What,
						{ { RewardData = { Name = PickedName, Weapon = PickedWeapon } } },
						0,
						LocalPlayer.Character.HumanoidRootPart,
						LocalPlayer
					)
					API.AddNotificationToWeapon(PickedName, PickedWeapon)
				end)
			end
		end

		if not API._ascidaInjectHooked then
			API._ascidaInjectHooked = true

			local PendingCase = nil
			local PendingQty = 1

			local function WatchObject(Obj)
				if not (Obj:IsA("TextLabel") or Obj:IsA("TextButton")) then
					return
				end

				local function Check()
					if Obj.Text ~= "Failed to open, you probably already have everything!" then
						return
					end

					for _, V in pairs(LocalPlayer.PlayerGui:GetDescendants()) do
						if (V:IsA("Frame") or V:IsA("ScrollingFrame")) and V.Visible then
							if V.AbsoluteSize.X > 50 and V.AbsoluteSize.Y > 50 and V.BackgroundTransparency < 1 then
								V.Visible = false
							end
						end
					end

					pcall(function()
						Obj.Parent:Destroy()
					end)

					local OpenedCase = PendingCase or CaseName
					local OpenedQty = PendingQty or 1

					PendingCase = nil
					PendingQty = 1

					task.spawn(function()
						OpenCase(OpenedCase, OpenedQty)
					end)
				end

				Check()
				Obj:GetPropertyChangedSignal("Text"):Connect(Check)
			end

			for _, Obj in pairs(game:GetDescendants()) do
				WatchObject(Obj)
			end

			game.DescendantAdded:Connect(function(Obj)
				WatchObject(Obj)
			end)

			API._SetPending = function(Name, Qty)
				PendingCase = Name
				PendingQty = Qty or 1
			end
		end

		API._SetPending(CaseName, Quantity or 1)

		local UnclaimedRewards = Library.PlayerDataController:Get("UnclaimedRewards")
		table.insert(UnclaimedRewards, { Name = CaseName, Quantity = Quantity or 1 })
		API.Replicate()
	end

