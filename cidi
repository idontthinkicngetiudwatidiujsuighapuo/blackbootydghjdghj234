	API.HookViewModel = function()
		task.spawn(function()
			local ClientItemPath = PlayerScripts:WaitForChild("Modules", 10)
				:WaitForChild("ClientReplicatedClasses", 10)
				:WaitForChild("ClientFighter", 10)
				:WaitForChild("ClientItem", 10)

			local Ok, ClientItem = pcall(require, ClientItemPath)
			if not Ok or not ClientItem then
				return
			end

			if ClientItem._CreateViewModel and not ClientItem.__hooked_CreateViewModel then
				ClientItem.__hooked_CreateViewModel = true

				local Orig = ClientItem._CreateViewModel
				ClientItem._CreateViewModel = function(Self, ViewmodelRef)
					local WeaponName = Self.Name
					local IsMine = Self.ClientFighter and Self.ClientFighter.Player == LocalPlayer

					if IsMine and Equipped[WeaponName] and ViewmodelRef then
						local DataKey = Self:ToEnum("Data")
						local VD = ViewmodelRef[DataKey]
						if VD then
							local Eq = Equipped[WeaponName]
							if Eq.Skin then
								if Eq.Skin.Name == "RANDOM_COSMETIC" then
									local RandomSkin = API.GetRandom(WeaponName, "Skin")
									if RandomSkin then
										VD[Self:ToEnum("Skin")] = RandomSkin
										VD[Self:ToEnum("Name")] = RandomSkin.Name
									end
								else
									VD[Self:ToEnum("Skin")] = Eq.Skin
									VD[Self:ToEnum("Name")] = Eq.Skin.Name
								end
							end
							if Eq.Charm then
								if Eq.Charm.Name == "RANDOM_COSMETIC" then
									local RandomCharm = API.GetRandom(WeaponName, "Charm")
									if RandomCharm then
										VD[Self:ToEnum("Charm")] = RandomCharm
									end
								else
									VD[Self:ToEnum("Charm")] = Eq.Charm
								end
							end
						end
					end

					local Result = Orig(Self, ViewmodelRef)

					if IsMine and Equipped[WeaponName] and ViewmodelRef then
						task.defer(function()
							pcall(function()
								local VD = ViewmodelRef[Self:ToEnum("Data")]
								if not VD then
									return
								end
								local Eq = Equipped[WeaponName]
								if Eq and Eq.Finisher then
									if Eq.Finisher.Name == "RANDOM_COSMETIC" then
										local RandomFinisher = API.GetRandom(WeaponName, "Finisher")
										if RandomFinisher then
											VD[Self:ToEnum("Finisher")] = RandomFinisher
										end
									else
										local FEnum = Eq.Finisher.Enum
										if not FEnum and Library.EnumLibrary and Library.EnumLibrary.ToEnum then
											pcall(function()
												FEnum = Library.EnumLibrary:ToEnum(Eq.Finisher.Name)
											end)
										end
										if FEnum then
											VD[Self:ToEnum("Finisher")] = FEnum
										end
									end
								end
							end)
						end)
					end

					return Result
				end
			end

			local ViewModelModule = ClientItemPath:FindFirstChild("ClientViewModel")
			if not ViewModelModule then
				return
			end

			local Ok2, ViewModel = pcall(require, ViewModelModule)
			if not Ok2 or not ViewModel or not ViewModel.GetWrap or ViewModel.__hooked_GetWrap then
				return
			end
			ViewModel.__hooked_GetWrap = true

			local OrigGetWrap = ViewModel.GetWrap
			ViewModel.GetWrap = function(Self)
				local CI = Self.ClientItem
				if CI and CI.ClientFighter and CI.ClientFighter.Player == LocalPlayer then
					local WeaponName = CI.Name
					local Eq = Equipped[WeaponName]
					if Eq and Eq.Wrap then
						if Eq.Wrap.isRandom or Eq.Wrap.Name == "RANDOM_COSMETIC" then
							local WrapData = API.GetRandom(WeaponName, "Wrap")
							if WrapData then
								return WrapData
							end
						end
						return Eq.Wrap
					end
				end
				return OrigGetWrap(Self)
			end

			local ClientEntity = require(LocalPlayer.PlayerScripts.Modules.ClientReplicatedClasses.ClientEntity)
			if ClientEntity.ReplicateFromServer and not ClientEntity._ascidaFinisherHooked then
				ClientEntity._ascidaFinisherHooked = true

				local LastUsedWeapon
				local OrigReplicateFromServer = ClientEntity.ReplicateFromServer
				ClientEntity.ReplicateFromServer = function(Self, Action, ...)
					if Library.FighterController and Library.FighterController.LocalFighter then
						local Item = Library.FighterController.LocalFighter.EquippedItem
						if Item then
							LastUsedWeapon = Item.Name
						end
					end

					if Action == "FinisherEffect" then
						pcall(function()
							local Storage = getgenv().UI
								and getgenv().UI.Storage
								and getgenv().UI.Storage.CustomSounds.FINISH
							if Storage and Storage.Enabled and Storage.Id ~= "" then
								local Sound = Instance.new("Sound")
								Sound.SoundId = Storage.Id
								Sound.Volume = math.min(Storage.Volume or 1, 1)
								Sound.PlaybackSpeed = Storage.Pitch or 1
								Sound.RollOffMaxDistance = 0
								Sound.Parent = workspace
								Sound:Play()
								Services.Debris:AddItem(Sound, 5)
							end
						end)

						local Args = { ... }
						local enumVal, isFinal, eliminator, serial = ...
						local KillerName = Args[3]
						local DecodedKiller = KillerName
						if type(KillerName) == "userdata" and Library.EnumLibrary and Library.EnumLibrary.FromEnum then
							pcall(function()
								DecodedKiller = Library.EnumLibrary:FromEnum(KillerName)
							end)
						end
						local Finishers = Services.ReplicatedStorage.Modules.Finishers
						local IsOurKill = tostring(DecodedKiller) == LocalPlayer.Name
							or tostring(DecodedKiller):lower() == LocalPlayer.Name:lower()
						if
							IsOurKill
							and LastUsedWeapon
							and Equipped[LastUsedWeapon]
							and Equipped[LastUsedWeapon].Finisher
						then
							if Equipped[LastUsedWeapon].Finisher.Name == "RANDOM_COSMETIC" then
								local RandomFinisher = API.GetRandom(LastUsedWeapon, "Finisher")
								if RandomFinisher then
									local FinisherEnum = RandomFinisher.Enum
									if not FinisherEnum and Library.EnumLibrary and Library.EnumLibrary.ToEnum then
										pcall(function()
											FinisherEnum = Library.EnumLibrary:ToEnum(RandomFinisher.Name)
										end)
									end
									if FinisherEnum then
										local subject = Self.Model or (Self.RootPart and Self.RootPart.Parent)
										if not subject or not subject:IsDescendantOf(workspace) then
											return
										end

										local clone = subject:Clone()
										pcall(function()
											clone.Parent = workspace
										end)

										local function FindFirstDescendantOfClass(parent, class)
											for _, v in ipairs(parent:GetDescendants()) do
												if v:IsA(class) then
													return v
												end
											end
										end

										local finisher = require(Finishers[RandomFinisher.Name]).new(
											FindFirstDescendantOfClass(clone, "Humanoid"),
											isFinal,
											eliminator
										)
										local origDestroy = finisher.Destroy

										finisher.Destroy = function(f)
											pcall(function()
												clone:Destroy()
											end)
											return origDestroy(f)
										end

										finisher:SetSerial(serial)
										finisher:Simulate()

										Self.Model:Destroy()
									end
								end
							else
								local FinisherData = Equipped[LastUsedWeapon].Finisher
								local FinisherEnum = FinisherData.Enum
								if not FinisherEnum and Library.EnumLibrary and Library.EnumLibrary.ToEnum then
									pcall(function()
										FinisherEnum = Library.EnumLibrary:ToEnum(FinisherData.Name)
									end)
								end
								if FinisherEnum then
									local subject = Self.Model or (Self.RootPart and Self.RootPart.Parent)
									if not subject or not subject:IsDescendantOf(workspace) then
										return
									end

									local clone = subject:Clone()
									pcall(function()
										clone.Parent = workspace
									end)

									local finisher = require(Finishers[FinisherData.Name]).new(
										clone:FindFirstChildOfClass("Humanoid"),
										isFinal,
										eliminator
									)
									local origDestroy = finisher.Destroy

									finisher.Destroy = function(f)
										pcall(function()
											clone:Destroy()
										end)
										return origDestroy(f)
									end

									finisher:SetSerial(serial)
									finisher:Simulate()

									Self.Model:Destroy()
								end
							end
						end
					end

					return OrigReplicateFromServer(Self, Action, ...)
				end
			end
		end)
	end

