	local CloneCosmetic = function(CosmeticName, CosmeticType, Options)
		local Base = Library.CosmeticLibrary.Cosmetics[CosmeticName]

		if not Base then
			return nil
		end

		local Cloned = {}
		for K, V in pairs(Base) do
			Cloned[K] = V
		end

		Cloned.Name = CosmeticName
		Cloned.Type = Cloned.Type or CosmeticType
		Cloned.Seed = math.random(1, 1000000)
		Cloned.Inverted = Options and Options.IsInverted or false

		if Options and Options.OnlyUseFavorites then
			Cloned.OnlyUseFavorites = true
		end

		if Options and Options.isRandom then
			Cloned.isRandom = true
		end

		pcall(function()
			local EnumId = Library.EnumLibrary:ToEnum(CosmeticName)
			if EnumId then
				Cloned.Enum, Cloned.ObjectID = EnumId, EnumId
			end
		end)

		return Cloned
	end

