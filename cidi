	API.UnlockRandomCosmetics = function(Count, CosmeticType)
		local Pool = {}
		for Name, Data in pairs(Library.CosmeticLibrary.Cosmetics) do
			if not CosmeticType or tostring(Data.Type) == CosmeticType then
				table.insert(Pool, Name)
			end
		end
		local Unlocked = 0
		local LastName = nil
		while Unlocked < Count and #Pool > 0 do
			local Idx = math.random(1, #Pool)
			local Name = Pool[Idx]
			UnlockedItems[Name] = true
			LastName = Name
			table.remove(Pool, Idx)
			Unlocked += 1
		end
		API.Replicate()
		return LastName
	end

	API.LockRandomCosmetics = function(Count, CosmeticType)
		local Pool = {}
		for Name, Data in pairs(Library.CosmeticLibrary.Cosmetics) do
			if not CosmeticType or tostring(Data.Type) == CosmeticType then
				table.insert(Pool, Name)
			end
		end
		local Locked = 0
		while Locked < Count and #Pool > 0 do
			local Idx = math.random(1, #Pool)
			UnlockedItems[Pool[Idx]] = nil
			table.remove(Pool, Idx)
			Locked += 1
		end
		API.Replicate()
	end

	API.CreateCosmetic = function(type, name, args)
		if Library.CosmeticLibrary.Cosmetics[name] then
			return getgenv().UI.Notify("Ascida", "Cosmetic with this name already exists: " .. name, true)
		end

		local function addOwnership(cosmeticName)
			local oldOwnsCosmetic = Library.CosmeticLibrary.OwnsCosmetic
			Library.CosmeticLibrary.OwnsCosmetic = function(self, playerData, cName, weaponName)
				if cName == cosmeticName then
					return true
				end
				return oldOwnsCosmetic(self, playerData, cName, weaponName)
			end

			local oldOwnsCosmeticNormally = Library.CosmeticLibrary.OwnsCosmeticNormally
			Library.CosmeticLibrary.OwnsCosmeticNormally = function(self, playerData, cName)
				if cName == cosmeticName then
