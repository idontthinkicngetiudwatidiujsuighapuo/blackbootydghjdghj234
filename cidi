	local function SpoofUserId(UserId)
		local OldIndex
		OldIndex = hookmetamethod(
			game,
			"__index",
			newcclosure(function(Self, Key)
				if rawequal(Self, LocalPlayer) and Key == "UserId" then
					return UserId
				end
				return OldIndex(Self, Key)
			end)
		)
	end

	local function ApplyImageSpoof(UserId)
		local HeadshotURL = "https://www.roblox.com/headshot-thumbnail/image?userId="
			.. UserId
			.. "&width=420&height=420&format=png"

		for _, V in ipairs(game:GetDescendants()) do
			if V:IsA("ImageLabel") or V:IsA("ImageButton") then
				if tostring(V.Image):find(tostring(OriginalId)) then
					V.Image = HeadshotURL
				end
			end
		end

		if CurrentImageConnection then
			CurrentImageConnection:Disconnect()
		end

		CurrentImageConnection = game.DescendantAdded:Connect(function(V)
			if V:IsA("ImageLabel") or V:IsA("ImageButton") then
				task.wait()
				if tostring(V.Image):find(tostring(OriginalId)) then
					V.Image = HeadshotURL
				end
			end
		end)
	end

	local function ApplyAvatar(Data)
		if not AvatarEnabled then
			return
		end

		task.spawn(function()
			pcall(function()
				local Char = LocalPlayer.Character
				if not Char then
					return
				end

				local Hum = Char:FindFirstChild("Humanoid")
				if not Hum then
					return
				end

				LocalPlayer.CharacterAppearanceId = Data.id

				pcall(function()
					Char.Name = Data.name
					Hum.DisplayName = Data.displayName or Data.name
				end)

				local App
				local Ok = pcall(function()
					App = Services.Players:GetCharacterAppearanceAsync(Data.id)
				end)
				if not Ok or not App then
					return
				end

				SpoofUserId(Data.id)
				ApplyImageSpoof(Data.id)

				for _, V in ipairs(Char:GetChildren()) do
					if V:IsA("Accessory") or V:IsA("Shirt") or V:IsA("Pants") or V:IsA("BodyColors") then
						pcall(function()
							V:Destroy()
						end)
					end
				end

				for _, V in ipairs(App:GetChildren()) do
					if V:IsA("Shirt") or V:IsA("Pants") or V:IsA("BodyColors") then
						pcall(function()
							V.Parent = Char
						end)
					elseif V:IsA("Accessory") then
						pcall(function()
							Hum:AddAccessory(V)
						end)
					end
				end

				local Head = Char:WaitForChild("Head", 3)
				if Head then
					local OldFace = Head:FindFirstChild("face")
					if OldFace then
						OldFace:Destroy()
					end

					if App:FindFirstChild("face") then
						App.face.Parent = Head
					else
						local Face = Instance.new("Decal")
						Face.Name = "face"
						Face.Face = "Front"
						Face.Texture = "rbxasset://textures/face.png"
						Face.Parent = Head
					end
				end

				local Parent = Char.Parent
				Char.Parent = nil
				Char.Parent = Parent
			end)
		end)
	end

