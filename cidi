	local HookedSoundModules = {}

	API.SpoofSound = function(SoundStorage, Search)
		pcall(function()
			local AnimationLibrary = Services.ReplicatedStorage.Modules.AnimationLibrary

			local function PlaySound(Vol, Pitch, OriginalId)
				if not SoundStorage.Enabled then
					return
				end
				local Sound = Instance.new("Sound")
				Sound.SoundId = SoundStorage.Original and OriginalId or SoundStorage.Id
				Sound.Volume = SoundStorage.Volume or Vol or 1
				Sound.PlaybackSpeed = SoundStorage.Pitch or Pitch or 1
				Sound.Parent = workspace
				Sound:Play()
				Services.Debris:AddItem(Sound, 5)
			end

			for _, Module in pairs(AnimationLibrary:GetChildren()) do
				if string.find(Module.Name:lower(), Search) then
					if HookedSoundModules[Module] then
						continue
					end
					HookedSoundModules[Module] = true

					local Ok, Fn = pcall(require, Module)
					if Ok and type(Fn) == "function" then
						local OrigFn = clonefunction(Fn)
						hookfunction(
							Fn,
							newcclosure(function(P1, A, B)
								local OrigCreateSound = P1.CreateSound
								P1.CreateSound = newcclosure(function(Self, SoundId, Vol, Pitch, ...)
									PlaySound(Vol, Pitch, SoundId)
									return OrigCreateSound(Self, SoundId, Vol, Pitch, ...)
								end)
								local Result = OrigFn(P1, A, B)
								P1.CreateSound = OrigCreateSound
								return Result
							end)
						)
					end
				end
			end
		end)
	end

