	API.HookRemote = function()
		if API._hookRemoteInstalled then
			return
		end
		API._hookRemoteInstalled = true

		local OldNamecall
		OldNamecall = hookmetamethod(
			game,
			"__namecall",
			newcclosure(function(Self, ...)
				if checkcaller() then
					return OldNamecall(Self, ...)
				end

				local Args = { ... }

				if Self == EquipRemote then
					local WeaponName = Args[1]
					local CosmeticType = Args[2]
					local CosmeticName = Args[3]
					local Options = Args[4] or {}

					if not WeaponName then
						return OldNamecall(Self, ...)
					end

					Equipped[WeaponName] = Equipped[WeaponName] or {}

					if not CosmeticName or CosmeticName == "None" or CosmeticName == "" then
						Equipped[WeaponName][CosmeticType] = nil
						if not next(Equipped[WeaponName]) then
							Equipped[WeaponName] = nil
						end
					elseif CosmeticName == "RANDOM_COSMETIC" then
						OnlyUseFavorites[WeaponName] = OnlyUseFavorites[WeaponName] or {}
						OnlyUseFavorites[WeaponName][CosmeticType] = Options.OnlyUseFavorites or false

						Equipped[WeaponName][CosmeticType] = {
							isRandom = true,
							Name = "RANDOM_COSMETIC",
							Seed = math.random(1, 9999999),
							OnlyUseFavorites = Options.OnlyUseFavorites or false,
							Type = CosmeticType,
						}
					else
						API.SpoofGameComparator(WeaponName, CosmeticName)

						local Cloned = CloneCosmetic(CosmeticName, CosmeticType, {
							IsInverted = Options.IsInverted or false,
						})

						if Cloned then
							Equipped[WeaponName][CosmeticType] = Cloned
						end
					end

					task.spawn(function()
						API.Replicate("WeaponInventory")
						API.SaveConfig()
					end)

					return nil
				end

				if Self == FavoriteRemote then
					local Weapon = Args[1]
					local CosmeticName = Args[2]
					local IsFavorited = Args[3]

					if Weapon and CosmeticName then
						Favorited[Weapon] = Favorited[Weapon] or {}
						Favorited[Weapon][CosmeticName] = IsFavorited or nil

						if not next(Favorited[Weapon]) then
							Favorited[Weapon] = nil
						end

						if OnlyUseFavorites[Weapon] then
							OnlyUseFavorites[Weapon][CosmeticName] = IsFavorited and true or nil
						end
					end

					task.spawn(function()
						API.Replicate("FavoritedCosmetics")
						API.SaveConfig()
					end)

					return nil
				end

				if Self == EquipEmote then
					local Slot = Args[1]
					local EmoteName = Args[2]

					EquippedEmote = EmoteName
					EquippedSlot = Slot

					task.spawn(function()
						API.Replicate("EquippedEmotes")
					end)

					return nil
				end

				return OldNamecall(Self, ...)
			end)
		)
	end

