				Default = Color3.fromRGB(255, 255, 255),
				Title = "Accent Color",
				Callback = function(color)
					UI.Storage["CCC_Accent"] = color
				end,
			})

			UI.CreateDropdown("Material", API.GetEnums(Enum.Material), function(value)
				UI.Storage["CCC_Wrap3"] = value

				Callback()
			end, 1, false, UI.Dependency)

			UI.Dependency:SetupDependencies({
				{ UI.Options["type"], "Wrap" },
			})
		end

		UI.Groupbox:AddDivider()

		UI.Groupbox:AddButton("Create", function()
			Callback("create")
		end)

		UI.Groupbox:AddButton("Delete", function()
			Callback("delete")
		end)
	end

	UI.Groupbox = UI.Tabs.Configuration:AddRightGroupbox("Fast Options", "zap")

	do
		UI.CreateToggle("Unlock Unobtainable", function(value)
			if value then
				API.UnlockCosmeticsByRarity("Unobtainable")
				UI.Notify("Ascida", "Unlocked unobtainable cosmetics!")
			else
				API.LockCosmeticsByRarity("Unobtainable")
				UI.Notify("Ascida", "Locked unobtainable cosmetics!")
			end
		end, false)

		UI.CreateToggle("Unlock Weapons", function(value)
			if value then
				API.UnlockWeapons()
				UI.Notify("Ascida", "Unlocked all weapons!")
			else
				API.LockWeapons()
				UI.Notify("Ascida", "Locked all weapons!")
			end
		end, false)

		UI.Groupbox:AddDivider()

		UI.Groupbox:AddButton("Unlock Everything", function()
			API.UnlockCosmetics()
			UI.Notify("Ascida", "Unlocked all cosmetics!")
		end)

		UI.Groupbox:AddButton("Lock Everything", function()
			API.LockCosmetics()
			UI.Notify("Ascida", "Locked all cosmetics!")
		end)
	end

	UI.Groupbox = UI.Tabs.Configuration:AddRightGroupbox("Watermark", "circle-dashed")

	do
		UI.Storage["W_Enabled"] = false
		UI.Storage["W_ShowFPS"] = true
		UI.Storage["W_ShowPing"] = true
		UI.Storage["W_ShowPlayer"] = true

		UI.CreateToggle("Watermark Enabled", function(value)
			UI.Storage["W_Enabled"] = value
		end, false, "Enables watermark")

		UI.CreateToggle("Show FPS", function(value)
			UI.Storage["W_ShowFPS"] = value
		end, true, "Shows FPS")

		UI.CreateToggle("Show Ping", function(value)
			UI.Storage["W_ShowPing"] = value
		end, true, "Shows ping")

		UI.CreateToggle("Show Player", function(value)
			UI.Storage["W_ShowPlayer"] = value
		end, true, "Shows local player name")

		do
			local LocalPlayer = API.GetLocalPlayer()

			local Watermark = UI.Library:AddDraggableLabel("Ascida")

			local FrameTimer = tick()
			local FrameCounter = 0
			local FPS = 60

			Services.RunService.RenderStepped:Connect(function()
				Watermark:SetVisible(UI.Storage["W_Enabled"])

				FrameCounter += 1
				if (tick() - FrameTimer) >= 1 then
					FPS = FrameCounter
					FrameTimer = tick()
					FrameCounter = 0
				end

				local parts = {}

				table.insert(parts, "Ascida")

				if UI.Storage["W_ShowPlayer"] then
					table.insert(parts, LocalPlayer.Name)
				end

				if UI.Storage["W_ShowFPS"] then
					table.insert(parts, tostring(math.floor(FPS)) .. " FPS")
				end

				if UI.Storage["W_ShowPing"] then
					local ping = math.floor(Services.Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
					table.insert(parts, ping .. " ms")
				end

				Watermark:SetText(table.concat(parts, " | "))
			end)
		end
	end

	do
		UI.ThemeManager:SetLibrary(UI.Library)
		UI.ThemeManager:ApplyToTab(UI.Tabs.Configuration)
	end
end

do
	local function IsVisible(obj)
		local current = obj
		while current do
			if current:IsA("GuiObject") and not current.Visible then
				return false
			end
			current = current.Parent
		end
		return true
	end

	local TargetLabel = nil

	for _, v in ipairs(Services.CoreGui:GetDescendants()) do
		if v:IsA("TextLabel") and v.Text == "discord.gg/ascida ・ Premium" then
			TargetLabel = v
			break
		end
	end

	Services.RunService.Heartbeat:Connect(function()
		if not TargetLabel then
			return
		end
	end)
end

API.Initialize()
