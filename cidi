		end
		if not isfolder("ascida/wraps") then
			makefolder("ascida/wraps")
		end
	end

	EnsureFolders()

	Config.Save = function(File, Content)
		EnsureFolders()
		local Ok, Json = pcall(function()
			return Services.HttpService:JSONEncode(Content)
		end)
		if Ok then
			pcall(function()
				writefile(File, Json)
			end)
		end
	end

	Config.Read = function(File)
		if not isfile(File) then
			return {}
		end
		local Ok, Data = pcall(function()
			return Services.HttpService:JSONDecode(readfile(File))
		end)
		return (Ok and Data) or {}
	end
end

-- // Server \\ --
local Server = {}
do
	Server.URL = "https://ascida-sync-2-default-rtdb.firebaseio.com/"
	Server.Storage = {}

	Server.GenerateSessionKey = function()
		local RNG = Random.new(tick())
		local Chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
		local Key = ""
		for _ = 1, 10 do
			local RandIdx = RNG:NextInteger(1, #Chars)
			Key = Key .. Chars:sub(RandIdx, RandIdx)
		end
		return Key
	end

	Server.MySessionKey = Server.GenerateSessionKey()

	Server.SendPayload = function(File, Payload)
		pcall((syn and syn.request) or (http and http.request) or http_request or request, {
			Url = Server.URL .. tostring(File),
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = Services.HttpService:JSONEncode(Payload),
		})
	end

	Server.Catch = function(File)
		local Success, Result = pcall((syn and syn.request) or (http and http.request) or http_request or request, {
			Url = Server.URL .. tostring(File),
			Method = "GET",
			Headers = { ["Content-Type"] = "application/json" },
		})

		if Success then
			return Services.HttpService:JSONDecode(Result.Body)
		end
	end
end

