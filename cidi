	API.SwapWeaponsWithUnobtainable = function(Weapon, Unobtainable)
		local VM = Library.ItemLibrary.ViewModels
		local Items = Library.ItemLibrary.Items

		local Target = VM[Weapon]
		local Cosmetic = VM[Unobtainable]
		local TargetItem = Items[Weapon]
		local CosmeticItem = Items[Unobtainable]

		if Target and Cosmetic then
			Target.Image = Cosmetic.Image
			Target.ImageHighResolution = Cosmetic.ImageHighResolution
			Target.EliminationFeedImage = Cosmetic.EliminationFeedImage
			Target.RootPartOffset = Cosmetic.RootPartOffset

			for AnimKey, AnimValue in pairs(Cosmetic.Animations or {}) do
				Target.Animations[AnimKey] = AnimValue
			end
		end

		if TargetItem and CosmeticItem then
			for K, V in pairs(CosmeticItem) do
				TargetItem[K] = V
			end
			TargetItem.Name = Weapon
		end

		local Spoofs = Config.Read(Config.Files.Spoofs)
		Spoofs["SwapWeaponsWithUnobtainable"] = Spoofs["SwapWeaponsWithUnobtainable"] or {}
		Spoofs["SwapWeaponsWithUnobtainable"][Weapon] = Unobtainable
		Config.Save(Config.Files.Spoofs, Spoofs)

		local ViewModels = PlayerScripts.Assets.ViewModels.Weapons
		local WeaponModel = ViewModels:FindFirstChild(Weapon)
		local UnobtainableModel = PlayerScripts.Assets.ViewModels.Weapons.Unobtainable:FindFirstChild(Unobtainable)

		if WeaponModel and UnobtainableModel then
			local Cloned = UnobtainableModel:Clone()
			Cloned.Parent = WeaponModel.Parent
			WeaponModel:Destroy()
			Cloned.Name = Weapon
		end
	end

	API.SwapAnimations = function(Weapon, Cosmetic)
		local Target = Library.ItemLibrary.ViewModels[Weapon]
