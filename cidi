	local LootboxOrder = Library.CosmeticLibrary.LootboxOrder
	local Rewards = Library.CosmeticLibrary.Rewards
	local Cosmetics = Library.CosmeticLibrary.Cosmetics

	local POOLS = {}

	for _, LootboxName in ipairs(LootboxOrder) do
		local LootboxData = Rewards[LootboxName]
		if not LootboxData then
			continue
		end

		local Contents = LootboxData.GetContents and LootboxData.GetContents() or {}
		if #Contents == 0 then
			continue
		end

		POOLS[LootboxName] = {}

		for _, ItemName in ipairs(Contents) do
			local Cosmetic = Cosmetics[ItemName]
			if Cosmetic then
				table.insert(POOLS[LootboxName], {
					Name = ItemName,
					Rarity = tostring(Cosmetic.Rarity),
					Weapon = Cosmetic.ItemName,
				})
			end
		end
	end

