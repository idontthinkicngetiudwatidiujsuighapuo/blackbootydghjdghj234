	API.Initialize = function()
		for _, V in ipairs(Library.ItemLibrary.Items) do
			for _, I in ipairs({ "Skin", "Wrap", "Charm", "Finisher" }) do
				API.Equip(V, I, "None", {})
			end
		end

		API.SpoofProfile()
		API.UnlockCosmetics()
		API.HookWeaponData()
		API.HookRemote()
		API.SpoofViewModelImage()
		API.HookViewModel()
		API.UnlockInventory()
		API.LoadConfig()
		API.Replicate()

		local Modules = Services.ReplicatedStorage:WaitForChild("Modules")
		local Controllers = PlayerScripts:WaitForChild("Controllers")

		local EmoteCtrl = require(Controllers:WaitForChild("EmoteController", 10))

		local CurrentEmote = nil
		local EmoteBool = Instance.new("BoolValue")
		EmoteBool.Value = false

		local function StopCurrentEmote()
			if not CurrentEmote or CurrentEmote._destroyed then
				return
			end
			for _, Track in pairs(CurrentEmote._animation_tracks or {}) do
				pcall(function()
					Track:Stop(0)
					Track:Destroy()
				end)
			end
			CurrentEmote._animation_tracks = {}
			pcall(function()
				CurrentEmote:Destroy()
			end)
			CurrentEmote = nil
		end

		EmoteCtrl.UseEmote = function(Self, Slot)
			local Emotes = Library.PlayerDataController:Get("EquippedEmotes")
			local EmoteData = Emotes and Emotes[Slot]
			local EmoteName = type(EmoteData) == "table" and EmoteData.Name or EmoteData
			if not EmoteName then
				return
			end

			LocalPlayer.Character.Humanoid.WalkSpeed = 5

			local EmoteModule = require(Modules.Emotes:FindFirstChild(EmoteName))
			local Humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if not Humanoid then
				return
			end

			StopCurrentEmote()

			local EmoteInstance = EmoteModule.new(Humanoid)
			CurrentEmote = EmoteInstance
			EmoteBool.Value = true
			EmoteInstance:PlayClient()

			local EmoteConnections = {}
			local function CancelEmote()
				for _, Conn in pairs(EmoteConnections) do
					Conn:Disconnect()
				end
				StopCurrentEmote()
				EmoteBool.Value = false
			end

			EmoteConnections[1] = Humanoid.Jumping:Connect(function(Active)
				if Active then
					CancelEmote()
				end
			end)

			EmoteInstance.Destroying:Connect(function()
				for _, Conn in pairs(EmoteConnections) do
					Conn:Disconnect()
				end
				if CurrentEmote == EmoteInstance then
					CurrentEmote = nil
				end
			end)
		end

		local CameraController = require(LocalPlayer.PlayerScripts.Controllers.CameraController)

		EmoteBool:GetPropertyChangedSignal("Value"):Connect(function()
			CameraController:SetThirdPersonOverride(EmoteBool.Value)
			CameraController.CameraState:TogglePOV()
		end)

		API.LoadConfig()
		API.Replicate()
	end
end

