	API.ApplyCustomWrap = function(URL)
		local Path = "ascida/wraps/custom.png"

		if not isfolder("ascida") then
			makefolder("ascida")
		end
		if not isfolder("ascida/wraps") then
			makefolder("ascida/wraps")
		end

		local Ok, WrapData = pcall(function()
			return game:HttpGet(URL)
		end)
		if not Ok or not WrapData then
			return
		end

		writefile(Path, WrapData)
		local TextureId = getcustomasset(Path)

		if WrapTextures then
			local Old = WrapTextures:FindFirstChild("CustomWrap")
			if Old then
				Old:Destroy()
			end

			local CustomFolder = Instance.new("Folder")
			CustomFolder.Name = "CustomWrap"
			CustomFolder.Parent = WrapTextures

			for _ = 1, 6 do
				local Tex = Instance.new("Texture")
				Tex.Name = "Gradient"
				Tex.Texture = TextureId
				Tex.Parent = CustomFolder
			end
		end

		CustomWrapEnabled = true
	end

	API.RenameWeapon = function(Weapon, NewName)
		local Genv = getgenv()
		Genv.weaponData = Genv.weaponData or {}

		if not Genv.weaponData[Weapon] then
			Genv.weaponData[Weapon] = { new = NewName, tracked = {} }

			local WeaponEntry = Genv.weaponData[Weapon]

			local function Track(Obj)
				if Obj:IsA("TextLabel") or Obj:IsA("TextButton") then
					if Obj.Text == Weapon then
						table.insert(WeaponEntry.tracked, Obj)
						Obj.Text = WeaponEntry.new
					end
				end
			end

			local function UpdateTracked()
				for I = #WeaponEntry.tracked, 1, -1 do
					local Obj = WeaponEntry.tracked[I]
					if Obj and Obj.Parent then
						Obj.Text = WeaponEntry.new
					else
						table.remove(WeaponEntry.tracked, I)
					end
				end
			end

			for _, V in ipairs(game:GetDescendants()) do
				Track(V)
			end

			game.DescendantAdded:Connect(Track)

			coroutine.wrap(function()
				local Last = WeaponEntry.new
				while true do
					task.wait(0.5)
					if WeaponEntry.new ~= Last then
						Last = WeaponEntry.new
						UpdateTracked()
					end
				end
			end)()
		else
			Genv.weaponData[Weapon].new = NewName
		end
	end

