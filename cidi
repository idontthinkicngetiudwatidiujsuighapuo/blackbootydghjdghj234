	API.UnlockRankCharm = function(Charm, Season)
		Season = Season or "Season 1"

		local CharmsPath = LocalPlayer.PlayerScripts.Assets.Charms[Season].Extra

		local DestinationRanks = {
			"Unranked",
			"Bronze 1",
			"Bronze 2",
			"Bronze 3",
			"Silver 1",
			"Silver 2",
			"Silver 3",
			"Gold 1",
			"Gold 2",
			"Gold 3",
			"Platinum 1",
			"Platinum 2",
			"Platinum 3",
			"Diamond 1",
			"Diamond 2",
			"Diamond 3",
			"Onyx 1",
			"Onyx 2",
			"Onyx 3",
			"Nemesis",
		}

		local BackupFolder = LocalPlayer.PlayerScripts.Assets.Charms:FindFirstChild("__Backup__" .. Season)
		if not BackupFolder then
			BackupFolder = Instance.new("Folder")
			BackupFolder.Name = "__Backup__" .. Season
			BackupFolder.Parent = LocalPlayer.PlayerScripts.Assets.Charms

			for _, Rank in ipairs(DestinationRanks) do
				local DestFolder = CharmsPath[Rank]
				if DestFolder then
					local RankBackup = Instance.new("Folder")
					RankBackup.Name = Rank
					RankBackup.Parent = BackupFolder
					for _, Child in pairs(DestFolder:GetChildren()) do
						Child:Clone().Parent = RankBackup
					end
				end
			end
		end

		for _, Rank in ipairs(DestinationRanks) do
			local DestFolder = CharmsPath[Rank]
			if DestFolder then
				local RankBackup = BackupFolder:FindFirstChild(Rank)
				for _, Child in pairs(DestFolder:GetChildren()) do
					Child:Destroy()
				end
				if RankBackup then
					for _, Child in pairs(RankBackup:GetChildren()) do
						Child:Clone().Parent = DestFolder
					end
				end
			end
		end

		local SourceFolder = CharmsPath[Charm]
		if not SourceFolder then
			return
		end

		for _, Rank in ipairs(DestinationRanks) do
			local DestFolder = CharmsPath[Rank]
			if DestFolder then
				for _, Child in pairs(DestFolder:GetChildren()) do
					Child:Destroy()
				end
				for _, Child in pairs(SourceFolder:GetChildren()) do
					local Cloned = Child:Clone()
					Cloned.Parent = DestFolder
					if Cloned.Name == "Rank" then
						local SurfaceGui = Cloned:FindFirstChild("SurfaceGui")
						if SurfaceGui then
							local Label = SurfaceGui:FindFirstChild("TextLabel")
							if Label then
								Label.Text = Rank
							end
						end
					end
				end
				Library.SeasonLibrary:FormatSeasonRankCharm(DestFolder, DestFolder, Season, nil, 2)
			end
		end

		API.Replicate()
	end

	API.HookWeaponData = function()
		pcall(function()
			OriginalGetWeaponData = Library.PlayerDataController.GetWeaponData

			Library.PlayerDataController.GetWeaponData = function(Self, WeaponName)
				if not WeaponName or tostring(WeaponName) == "nil" then
					return
				end
				local WeaponData = { Unlocked = true, Level = 1, XP = 1 }

				local Ok, Original = pcall(OriginalGetWeaponData, Self, WeaponName)
				if Ok and Original then
					for K, V in pairs(Original) do
						if K ~= "Unlocked" and K ~= "Level" and K ~= "XP" then
							WeaponData[K] = V
						end
					end
				end

				if Equipped and Equipped[WeaponName] then
					for CosmeticType, CosmeticData in pairs(Equipped[WeaponName]) do
						WeaponData[CosmeticType] = CosmeticData
					end
				end

				return WeaponData
			end

			HookedGetWeaponData = Library.PlayerDataController.GetWeaponData
		end)
	end

