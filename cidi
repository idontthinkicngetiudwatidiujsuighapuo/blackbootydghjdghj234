	API.UnlockInventory = function()
		local OldGet = Library.PlayerDataController.Get
		Library.PlayerDataController.Get = function(Self, Key)
			if Key == "CosmeticInventory" then
				local Inv = OldGet(Self, Key) or {}
				local Merged = {}
				for K, V in pairs(Inv) do
					Merged[K] = V
				end
				for K, V in pairs(UnlockedItems) do
					Merged[K] = V
				end
				if UnlockAll then
					return setmetatable(Merged, {
						__index = function()
							return true
						end,
					})
				end
				return Merged
			elseif Key == "FavoritedCosmetics" then
				return Favorited
			elseif Key == "DuelHistory" then
				return FakeHistory
			elseif Key == "LoggedELOEvents" then
				return {}
			elseif Key == "Seasons" then
				local Result = table.clone(OldGet(Self, Key))
				local SeasonName = Library.SeasonLibrary.CurrentSeason.Name
				Result[SeasonName] = Result[SeasonName] or {}
				Result[SeasonName].BattlePass = Result[SeasonName].BattlePass or {}
				if SeasonBundle ~= nil then
					Result[SeasonName].BattlePass.MaxPassTrackNum = SeasonBundle
				end
				Result[SeasonName].BattlePass.PassLevel = Library.SeasonLibrary.CurrentSeason.NumBattlePassTiers
				Result[SeasonName].BattlePass.RewardsClaimed = Result[SeasonName].BattlePass.RewardsClaimed or {}
				return Result
			elseif Key == "EquippedEmotes" then
				local Result = OldGet(Self, Key) or {}
				if EquippedSlot and EquippedEmote then
					Result[EquippedSlot] = { Name = EquippedEmote }
				end
				return Result
			end
			return OldGet(Self, Key)
		end

		API.Replicate()
	end

	API.GetRandom = function(WeaponName, CosmeticType)
		if not WeaponName or WeaponName:find("MISSING_") then
			return nil
		end

		local Pool = {}
		for Name, Data in pairs(Library.CosmeticLibrary.Cosmetics) do
			if Data.Type and tostring(Data.Type) == CosmeticType then
				if Data.Type == "Skin" then
					if Data.ItemName and Data.ItemName == WeaponName then
						table.insert(Pool, Name)
					end
				else
					table.insert(Pool, Name)
				end
			end
		end

		local Favorites = OnlyUseFavorites[WeaponName]
		if Favorites then
			local FavoritePool = {}
			for _, Name in ipairs(Pool) do
				if Favorites[Name] then
					table.insert(FavoritePool, Name)
				end
			end
			if #FavoritePool > 0 then
				Pool = FavoritePool
			end
		end

		if #Pool == 0 then
			return nil
		end

		local Selected = Pool[math.random(1, #Pool)]
		if not Selected then
			return nil
		end

		local Base = Library.CosmeticLibrary.Cosmetics[Selected]
		if not Base then
			return nil
		end

		local Cloned = {}
		for K, V in pairs(Base) do
			Cloned[K] = V
		end
		Cloned.Name = Selected
		Cloned.Seed = math.random(1, 9999999)
		Cloned.Inverted = false

		pcall(function()
			local Eid = Library.EnumLibrary:ToEnum(Selected)
			if Eid then
				Cloned.Enum = Eid
				Cloned.ObjectID = Eid
			end
		end)

		return Cloned
	end

