		local function UnlockBundle(Bundle)
			if not Bundle then
				return
			end
			for _, Reward in pairs(Bundle.Rewards or {}) do
				if Reward.Name and Library.CosmeticLibrary.Cosmetics[Reward.Name] then
					Library.PlayerDataController.CurrentData.Data.CosmeticInventory = Library.PlayerDataController.CurrentData.Data.CosmeticInventory
						or {}
					rawset(Library.PlayerDataController.CurrentData.Data.CosmeticInventory, Reward.Name, true)
				end
			end
			Library.PlayerDataController.CurrentData:Replicate("CosmeticInventory")
			FixScreen()
		end

		BundleUnlockOriginalNamecall = hookmetamethod(
			game,
			"__namecall",
			newcclosure(function(Self, ...)
				if checkcaller() then
					return BundleUnlockOriginalNamecall(Self, ...)
				end

				local Method = getnamecallmethod()

				if Method == "PromptProductPurchase" or Method == "PromptGamePassPurchase" then
					local ProductId = select(2, ...)

					for _, Bundle in pairs(MonetizationLibrary.Bundles) do
						if Bundle.ProductID == ProductId or Bundle.GamepassID == ProductId then
							UnlockBundle(Bundle)
							return
						end
					end

					for _, Gamepass in pairs(MonetizationLibrary.Gamepasses) do
						if Gamepass.GamepassID == ProductId then
							if Gamepass.BundleName then
								UnlockBundle(MonetizationLibrary.Bundles[Gamepass.BundleName])
							end
							return
						end
					end

					return
				end

				return BundleUnlockOriginalNamecall(Self, ...)
			end)
		)
	end

