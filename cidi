		WrapController = require(LocalPlayer.PlayerScripts.Controllers.WrapController)
		WrapTextures = PlayerScripts.Assets:WaitForChild("WrapTextures")

		local OrigApplyWrap = WrapController.ApplyWrap

		WrapController.ApplyWrap = function(Self, P1, P2, P3, P4)
			if CustomWrapEnabled and P2 and P2.Name ~= "RANDOM_COSMETIC" then
				local WrapData = Library.CosmeticLibraryCosmetics[P2.Name]
				if WrapData and WrapData.WrapGroups then
					local CustomWrapData = {}
					for K, V in pairs(WrapData) do
						CustomWrapData[K] = V
					end

					local CustomGroups = {}
					for GroupId, GroupData in pairs(WrapData.WrapGroups) do
						local NewGroup = {}
						for K, V in pairs(GroupData) do
							NewGroup[K] = V
						end
						NewGroup.Textures = "CustomWrap"
						CustomGroups[GroupId] = NewGroup
					end
					CustomWrapData.WrapGroups = CustomGroups

					Library.CosmeticLibrary.Cosmetics[P2.Name] = CustomWrapData
					local Result = OrigApplyWrap(Self, P1, P2, P3, P4)
					Library.CosmeticLibrary.Cosmetics[P2.Name] = WrapData
					return Result
				end
			end
			return OrigApplyWrap(Self, P1, P2, P3, P4)
		end
	end)

